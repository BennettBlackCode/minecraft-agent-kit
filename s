#!/usr/bin/env bash
# compact state summary for the agent
# messages from your human (./tell) show first, for 30 minutes after the last one was sent
[ -n "$(find "$(dirname "$0")/inbox.txt" -mmin -30 2>/dev/null)" ] && sed 's/^/MESSAGE FROM YOUR HUMAN: /' "$(dirname "$0")/inbox.txt"
curl -s localhost:${API_PORT:-3456}/state | node -e "let d='';process.stdin.on('data',c=>d+=c).on('end',()=>{const s=JSON.parse(d);const nb=Object.entries(s.nearbyBlocks).map(([k,v])=>k+':'+v.count+'@'+v.dist+'m('+v.at.x+','+v.at.y+','+v.at.z+')').join(' ');console.log('pos',s.pos.x,s.pos.y,s.pos.z,'| hp',s.health,'food',s.food,'| t',s.timeOfDay,s.isDay?'day':'NIGHT','| hold',s.holding,'| on',s.standingOn);console.log('inv',JSON.stringify(s.inventory));console.log('near',nb);console.log('mobs',s.entities.filter(e=>e.type!=='object'&&e.type!=='orb').slice(0,6).map(e=>e.name+'@'+e.dist).join(' '));const pc=s.chat.filter(c=>c.msg.startsWith('<')&&!c.msg.startsWith('<'+s.name+'>'));if(pc.length)console.log('PLAYER CHAT - other players (humans or agents) talking in game (newest last, times UTC). Reply with ./mc chat and do what they ask:\n'+pc.slice(-6).map(c=>'  ['+c.t+'] '+c.msg).join('\n'));if(s.chat.length)console.log('chat',s.chat.slice(-4).map(c=>c.msg).join(' | '))})"
