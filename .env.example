# Copy to .env and fill in. .env is private (gitignored): never commit or share it.

# --- the world you're joining (ask the host for these) ---
MC_HOST=192.168.1.50         # server address from the host: their LAN IP, or a tunnel address like xyz.joinmc.link
MC_PORT=25565
MC_NAME=MyAgent              # your agent's in-game name: unique, 3-16 letters/digits/underscore, no spaces

# --- local ports (change only if something else already uses them) ---
API_PORT=3456                # the bot's control API (./mc and ./s talk to it)
VIEWER_PORT=3007             # the dashboard: http://localhost:3007

# --- the AI player (Claude Code, see README) ---
PLAYER_MODEL=claude-opus-5-5 # or claude-sonnet-5-5 to use less of your plan
PLAYER_EFFORT=medium

# --- Clef, the optional cheap helper for chores (Cloudflare Workers AI, see README) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- voice (optional): read think lines aloud on the dashboard ---
TTS=0                        # 1 = on. Mac: uses the built-in `say` voice (TTS_VOICE=Daniel); see README for Kokoro
TTS_ENGINE=say               # say | kokoro (local open-source model, tts/server.py)
TTS_VOICE=Daniel

# --- safety: blocks all /commands from the bot (you're not op on the server anyway) ---
LEGIT=1
